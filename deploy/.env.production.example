# GYM OS 2.0 — production settings for a single public server.
#
# deploy/install.sh copies this to .env on first run and fills in DOMAIN,
# JWT_SECRET and DB_PASSWORD with generated values. Edit by hand only for the
# optional sections below.
#
# Keep this file at chmod 600. It is the gym's credentials.

# ---------------------------------------------------------------- public name
# The hostname the gym visits. The installer defaults to <public-ip>.sslip.io,
# which needs no DNS at all; point a real domain here when you have one.
DOMAIN=CHANGE_ME.sslip.io

# ---------------------------------------------------------------- secrets
# At least 32 random characters. The 'prod' profile refuses to start without
# it, and changing it signs every staff member and member out.
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# The Postgres password. Changing it after the first start does NOT change the
# password already stored in the database volume — see docs/deployment.md.
#   openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

DB_NAME=gymdb
DB_USER=gymos

# ---------------------------------------------------------------- gym settings
# The password every member's portal account starts on. Public by design (the
# portal is read-only apart from class bookings). Changing it here also means
# changing the hash seeded by db/migrate.js — see the note in application.yml.
MEMBER_DEFAULT_PASSWORD=admin

# Local time for reports, class schedules and expiry dates.
TZ=Asia/Kolkata

# ---------------------------------------------------------------- email (optional)
# Used for password-reset OTPs. Leave blank to keep OTPs on the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------------------------------------------------------------- SMS (optional)
# Twilio, for OTPs sent to a member's phone. Leave blank to disable SMS.
SMS_TWILIO_SID=
SMS_TWILIO_TOKEN=
SMS_TWILIO_FROM=
