# The two hostnames the shared Caddy answers for.
#
# With no domain of your own, sslip.io resolves any subdomain to the IP
# embedded in it, so two distinct hostnames on the same box need no DNS
# setup at all — just two different labels in front of the same IP:
#
#   INSIGHTRAG_DOMAIN=insightrag.203-0-113-10.sslip.io
#   GYMOS_DOMAIN=gym.203-0-113-10.sslip.io

INSIGHTRAG_DOMAIN=CHANGE_ME
GYMOS_DOMAIN=CHANGE_ME
