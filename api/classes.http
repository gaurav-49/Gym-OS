###############################################################################
#  CLASSES — the timetable, bookings and waitlist
#  /api/classes
#
#  A full class waitlists the next member, and a cancellation promotes the
#  first person waiting. Series creates one class per chosen weekday.
#
#  Row ids in these samples are placeholders — take a real one from the
#  list request above it, or from the variable it captures.
#  Send the sign-in block first — it sets the token every request below uses.
#  Bodies work as-is against the demo data from db/seed-demo.js.
#  [CHANGES DATA] marks anything that writes.
###############################################################################

@host = http://localhost:8080
@json = Content-Type: application/json

### Sign in as staff  ← run me first
# @name login
POST {{host}}/api/auth/login
{{json}}

{ "username": "admin", "password": "admin123" }

###
@staff = {{login.response.body.token}}


### The timetable
# @name list
GET {{host}}/api/classes
Authorization: Bearer {{staff}}

###
@classId = {{list.response.body.$[0].id}}

### Who can take a class
GET {{host}}/api/classes/trainers
Authorization: Bearer {{staff}}

### One class, with its roster
GET {{host}}/api/classes/{{classId}}
Authorization: Bearer {{staff}}

### Schedule one  [CHANGES DATA]
POST {{host}}/api/classes
Authorization: Bearer {{staff}}
{{json}}

{ "name": "Morning Yoga", "trainer_id": 2, "class_date": "2026-09-08",
  "start_time": "07:00", "duration_minutes": 60, "capacity": 20 }

### Schedule a whole term at once  [CHANGES DATA]
POST {{host}}/api/classes/series
Authorization: Bearer {{staff}}
{{json}}

{ "name": "Evening HIIT", "trainer_id": 2, "start_time": "18:30",
  "duration_minutes": 45, "capacity": 15,
  "from_date": "2026-09-07", "to_date": "2026-10-05", "weekdays": [1, 3, 5] }

### Rejected: a class in the past → 400
POST {{host}}/api/classes
Authorization: Bearer {{staff}}
{{json}}

{ "name": "Yesterday", "trainer_id": 2, "class_date": "2020-01-01",
  "start_time": "07:00", "capacity": 10 }

### Move or resize one  [CHANGES DATA]
PUT {{host}}/api/classes/1
Authorization: Bearer {{staff}}
{{json}}

{ "start_time": "07:30", "capacity": 25 }

### Book a member in from the desk  [CHANGES DATA]
POST {{host}}/api/classes/1/book
Authorization: Bearer {{staff}}
{{json}}

{ "member_id": 1 }

### Cancel that booking — the first waitlisted member is promoted  [CHANGES DATA]
POST {{host}}/api/classes/1/cancel-booking
Authorization: Bearer {{staff}}
{{json}}

{ "member_id": 1 }

### Delete the class  [CHANGES DATA]
DELETE {{host}}/api/classes/99999
Authorization: Bearer {{staff}}
